# ============================================================
# 尾盘分析系统 — 环境变量配置
# 复制此文件为 .env 并修改对应参数
# 完整说明见 README.md 配置参数表
# ============================================================

# --- LLM Configuration (LiteLLM) ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

# --- Data Provider ---
# 数据源优先级 (逗号分隔, 从左到右优先级递减)
# Available: tencent, sector_based, sina, efinance, akshare
DATA_PROVIDER_PRIORITY=tencent,sector_based,sina,efinance,akshare
# 目标板块 (sector_based fetcher 用, 逗号分隔)
TARGET_SECTORS=半导体,软件开发,消费电子,通信设备,光伏设备,证券,汽车零部件,计算机设备
# API限流间隔 (秒, 随机均匀分布)
RATE_LIMIT_MIN_SLEEP=1.5
RATE_LIMIT_MAX_SLEEP=3.0

# --- L1 基础准入 ---
L1_MIN_TURNOVER=50000000      # 最低成交额 (元)
L1_MIN_TURNOVER_RATE=1.0      # 最低换手率 (%)
L1_MIN_PRICE=5.0              # 最低股价 (元)
# L1_MAX_PRICE 已移除 — 百元股不受限制，流动性由成交额/换手率保证

# --- L2 尾盘异动 ---
L2_VOLUME_RATIO=1.2           # 尾盘量比 (14:30后/13:00-14:30)
L2_LAST5MIN_VOLUME_PCT=5.0    # 最后5分钟量占比 (%)
L2_LATE_RALLY_PCT=2.0         # 尾盘拉升最低涨幅 (%)
L2_LATE_RECOVERY_DROP=3.0     # 企稳: 14:30前跌幅 (%)
L2_LATE_RECOVERY_RISE=1.5     # 企稳: 14:45后回升 (%)
L2_ACTIVE_BUY_PCT=55.0        # 主动买入占比 (%)
L2_REQUIRE_CAPITAL=true       # 资金流向是否作为硬门槛 (false=仅评分使用)
L2_MIN_PASS=10                # 最低通过数，不足时自动放宽资金条件
L2_BIG_ORDER_NET_MIN=0        # 大单净流入下限 (万元)
L2_BIG_ORDER_RATIO_MULT=1.3   # 尾盘大单占比 / 全天平均
L2_CANCEL_RATE_MAX=30.0       # 最大撤单率 (%)
L2_REQUIRE_ORDERBOOK=false    # 盘口数据硬门槛 (MVP阶段不启用)

# --- L3 技术面验证 ---
L3_SECTOR_RANK_TOP=30.0       # 板块排名Top百分位 (%)
L3_HISTORY_WIN_RATE=60.0      # 最低历史胜率 (%)
L3_VOL_RATIO_MIN=1.3          # 量比下限
L3_VOL_RATIO_MAX=1.8          # 量比上限
L3_MA5_CLOSE_RATIO_MIN=1.0    # 收盘/MA5 最低比率
L3_MA5_LOW_RATIO_MIN=0.98     # 最低价/MA5 最低比率

# --- L4 评分阈值 ---
L4_HIGH_THRESHOLD=85.0        # strong_buy 阈值 (>85)
L4_BUY_THRESHOLD=75.0         # buy 阈值 (75-85)
L4_MEDIUM_THRESHOLD=60.0      # watch 阈值 (60-75)
L4_MAX_HIGH_ATTENTION=15      # strong_buy 最大输出数
L4_MAX_TOTAL_OUTPUT=30        # 最大输出总数

# --- L4 A维度: 尾盘强度 (max 30) ---
# 格式: JSON数组 [[threshold, score], ...] 从高到低匹配
L4_LATE_PRICE_TIERS=[[4.0,8],[2.0,6],[1.0,4],[0.0,2]]
L4_VOL_RATIO_TIERS=[[3.0,8],[2.0,6],[1.5,4],[1.0,2]]
L4_LAST5MIN_BONUS_TIERS=[[15.0,1.0],[10.0,0.5]]
L4_BIG_ORDER_TIERS=[[0.3,8],[0.2,6],[0.1,4]]
L4_BIG_ORDER_NET_SCORE=2.0
L4_BID_ASK_TIERS=[[2.0,6],[1.5,4],[1.0,2]]

# --- L4 B维度: K线形态 (max 25) ---
L4_YANG_DAYS_TIERS=[[4,8],[3,6],[2,4],[1,2]]
L4_CLOSE_RISE_TIERS=[[4,7],[3,5],[2,3],[1,1]]
L4_VOLATILITY_PENALTY_TIERS=[[40,-2],[30,-1]]
L4_BODY_AMPLIFYING_SCORE=5.0
L4_YANG_NO_AMPLIFY_SCORE=2.0
L4_BROKE_HIGH_SCORE=5.0
L4_BREAKOUT_SCORE=3.0

# --- L4 C维度: 资金面 (max 20) ---
# flow_net_tiers 单位: 万元
L4_FLOW_NET_TIERS=[[1000,10],[500,7],[100,4]]
L4_FLOW_NET_POSITIVE_SCORE=2.0
L4_FLOW_RATIO_SCORE=5.0
L4_ACTIVE_BUY_TIERS=[[60,5],[55,3]]
L4_NORTHBOUND_TIERS=[[70,3],[55,1]]

# --- L4 D维度: 均线系统 (max 15) ---
# JSON对象: {"bullish":8,"above_ma5":5,"bottom_area":3,"low_above_ma5":2}
L4_MA_ALIGNMENT_SCORES={"bullish":8,"above_ma5":5,"bottom_area":3,"low_above_ma5":2}
L4_MA5_ACCEL_SCORE=4.0
L4_PRICE_MA5_TIERS=[[1.01,3],[1.005,2],[1.0,1]]

# --- L4 E维度: 市场环境 (max 10) ---
L4_SECTOR_PERF_TIERS=[[3,6],[1,4],[0,2],[-1,1]]
L4_CONCEPT_WEIGHT=0.4
L4_CONCEPT_MAX=4.0
L4_HOT_CONCEPT_PER_ITEM=1.5
L4_HOT_CONCEPT_MAX=4.0
L4_LEADER_BONUS=1.0

# --- Rule Scorer (LLM降级规则评分) ---
# 格式: [[threshold, weight], ...]
RULE_LATE_PRICE_TIERS=[[4,3],[2,2],[1,1]]
RULE_VOL_RATIO_TIERS=[[2.5,3],[1.5,2],[1.0,1]]
RULE_BIG_ORDER_TIERS=[[0.3,3]]
RULE_BIG_ORDER_NET_SCORE=1.0
RULE_MA_BULLISH_SCORE=2.0
RULE_MA_GOOD_SCORE=1.0
# 决策阶梯: [[min_score, decision, confidence], ...]
RULE_DECISION_TIERS=[[8,"buy","A"],[5,"buy","B"],[3,"hold","B"]]
RULE_DEFAULT_DECISION=["skip","C"]

# --- Pipeline 时间窗口 ---
S2_WINDOW_END=14:55           # S2 尾盘异常扫描截止
S3_WINDOW_END=14:57           # S3 技术面验证截止
S4_WINDOW_END=14:58           # S4 融合评分截止

# --- 时间循环间隔 (秒) ---
S1_LOOP_INTERVAL=180          # S1 K线扫描: 每3分钟
S2_LOOP_INTERVAL=60           # S2 尾盘异常: 每1分钟
S3_LOOP_INTERVAL=30           # S3 均线验证: 每30秒
S4_LOOP_INTERVAL=10           # S4 融合评分: 每10秒

# --- S0 板块预筛选 ---
S0_TOP_N=3                    # 取Top N个涨幅最大的板块
S0_MAX_N=5                    # 板块不足时自动扩展到N
S0_MIN_STOCKS=200             # 最少候选股票数

# --- S1 K线形态预筛选 ---
KLINE_MIN_ATR_PCT=2.0         # ATR/Close 最低 (%)
KLINE_MAX_ATR_PCT=8.5         # ATR/Close 最高 (%)
KLINE_MAX_CONSECUTIVE_UP=5    # 最多连涨天数
KLINE_MAX_UP_IN_9DAYS=6       # 近9天最多涨几天
KLINE_MAX_SINGLE_DAY_PCT=6.5  # 单日涨幅上限 (%)
KLINE_MIN_YANG_RATIO_4D=0.75  # 近4天阳线占比最低 (3/4)
KLINE_MIN_CONSECUTIVE_CLOSE_RISE=3   # 至少连续N天收盘上涨
KLINE_MIN_CLOSE_RISE_PCT=0.3         # 连续上涨每天最低涨幅 (%)
KLINE_MAX_ATR_MULTIPLE=2.0           # 单日涨幅 ≤ N倍ATR
# R2 深度验证 (不合格不淘汰，仅标记)
KLINE_MAX_DROP_RATIO=0.5             # 涨幅骤降判定 (后一天/前一天 < 0.5)
KLINE_MAX_CONSECUTIVE_DECLINE=3      # 连续递减天数阈值
KLINE_MAX_CONSECUTIVE_BODY_SHRINK=3  # 阳线实体连续缩小天数阈值
KLINE_MAX_UPPER_SHADOW_RATIO=0.6     # 上影线占实体比上限

# --- 资金流向 ---
ENABLE_CAPITAL_FLOW=true
MAX_CAPITAL_ENRICH=300        # S3资金流向富化上限

# --- 北向资金情绪 ---
ENABLE_NORTHBOUND=true

# --- 输出 ---
REPORT_OUTPUT_DIR=./reports
