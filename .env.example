# LLM Configuration (LiteLLM)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

# Data Provider Priorities (comma-separated, higher priority first)
# Available: tencent, sector_based, sina, efinance, akshare
DATA_PROVIDER_PRIORITY=tencent,sector_based,sina,efinance,akshare

# Target Sectors for sector_based fetcher (comma-separated industry names)
TARGET_SECTORS=半导体,软件开发,消费电子,通信设备,光伏设备,证券,汽车零部件,计算机设备

# Rate limiting between sector API calls (seconds, random uniform)
RATE_LIMIT_MIN_SLEEP=1.5
RATE_LIMIT_MAX_SLEEP=3.0

# Screening Thresholds (can override defaults)
L1_MIN_TURNOVER=50000000
L1_MIN_TURNOVER_RATE=1.0
L1_MIN_PRICE=5.0
L1_MAX_PRICE=100.0

L2_VOLUME_RATIO=2.5
L2_LAST5MIN_VOLUME_PCT=12.0
L2_LATE_RALLY_PCT=3.0
L2_LATE_RECOVERY_DROP=3.0
L2_LATE_RECOVERY_RISE=1.5
L2_ACTIVE_BUY_PCT=55.0

L3_SECTOR_RANK_TOP=30.0
L3_HISTORY_WIN_RATE=60.0

# Capital flow enrichment (东方财富 push2his + push2降级)
ENABLE_CAPITAL_FLOW=true
MAX_CAPITAL_ENRICH=300

# Northbound capital sentiment (同花顺 hsgtApi)
ENABLE_NORTHBOUND=true

# Output
REPORT_OUTPUT_DIR=./reports
