# ============================================================
# 尾盘分析系统 — 环境变量配置
# 完整说明见 README.md 配置参数表
# ============================================================

# --- LLM Configuration (LiteLLM) ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-15cecb1426424fccbc831ff60bc200ff
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

# --- Data Provider ---
DATA_PROVIDER_PRIORITY=tencent,sector_based,sina,efinance,akshare
TARGET_SECTORS=半导体,电子元件,通信设备,汽车零部件,计算机设备
RATE_LIMIT_MIN_SLEEP=1.5
RATE_LIMIT_MAX_SLEEP=3.0

# --- L1 基础准入 ---
L1_MIN_TURNOVER=50000000
L1_MIN_TURNOVER_RATE=1.0
L1_MIN_PRICE=5.0
L1_MAX_PRICE=100.0

# --- L2 尾盘异动 (已对齐代码默认值，旧值2.5/12.0/3.0已废弃) ---
# L2_VOLUME_RATIO=1.2
# L2_LAST5MIN_VOLUME_PCT=5.0
# L2_LATE_RALLY_PCT=2.0
# L2_LATE_RECOVERY_DROP=3.0
# L2_LATE_RECOVERY_RISE=1.5
# L2_ACTIVE_BUY_PCT=55.0
# L2_REQUIRE_CAPITAL=true
# L2_MIN_PASS=10
# L2_BIG_ORDER_NET_MIN=0
# L2_BIG_ORDER_RATIO_MULT=1.3
# L2_CANCEL_RATE_MAX=30.0
# L2_REQUIRE_ORDERBOOK=false

# --- L3 技术面验证 ---
# L3_MAX_VOLATILITY=0.60  ← 代码默认值
# L3_SECTOR_RANK_TOP=30.0
# L3_HISTORY_WIN_RATE=40.0
# L3_VOL_RATIO_MIN=1.1
# L3_VOL_RATIO_MAX=2.0
# L3_VOLATILITY_MAX=0.60  ← 代码默认值
# L3_MA5_CLOSE_RATIO_MIN=1.0
# L3_MA5_LOW_RATIO_MIN=0.98

# --- L4 评分阈值 (标准模式: 资金流+LLM都可用) ---
# 降级时阈值自动下调, 见 README "推荐阈值" 表
# L4_HIGH_THRESHOLD=80.0
# L4_BUY_THRESHOLD=72.0
# L4_MEDIUM_THRESHOLD=55.0

# --- L4 阶梯参数 (JSON格式) ---
# L4_LATE_PRICE_TIERS=[[4.0,8],[2.0,6],[1.0,4],[0.0,2]]
# L4_VOL_RATIO_TIERS=[[3.0,8],[2.0,6],[1.5,4],[1.0,2]]
# L4_BIG_ORDER_TIERS=[[0.3,8],[0.2,6],[0.1,4]]
# L4_YANG_DAYS_TIERS=[[4,8],[3,6],[2,4],[1,2]]
# L4_FLOW_NET_TIERS=[[1000,10],[500,7],[100,4]]

# --- Rule Scorer (LLM降级) ---
# RULE_LATE_PRICE_TIERS=[[4,3],[2,2],[1,1]]
# RULE_VOL_RATIO_TIERS=[[2.5,3],[1.5,2],[1.0,1]]
# RULE_DECISION_TIERS=[[8,"buy","A"],[5,"buy","B"],[3,"hold","B"]]

# --- Pipeline 时间窗口 ---
# S2_WINDOW_END=14:55
# S3_WINDOW_END=14:57
# S1/S4 为单次执行, 无窗口循环

# --- 时间循环间隔 (秒) ---
S1_LOOP_INTERVAL=180
S2_LOOP_INTERVAL=60
S3_LOOP_INTERVAL=30
# S1/S4 单次执行, 无需间隔

# --- S0 板块预筛选 ---
# S0_TOP_N=3
# S0_MAX_N=5
# S0_MIN_STOCKS=200

# --- S1 K线形态预筛选 (已对齐代码默认值) ---
# KLINE_MIN_ATR_PCT=2.0
# KLINE_MAX_ATR_PCT=8.5
# KLINE_MAX_CONSECUTIVE_UP=5
# KLINE_MAX_UP_IN_9DAYS=6
# KLINE_MAX_SINGLE_DAY_PCT=6.5
# KLINE_MIN_CONSECUTIVE_CLOSE_RISE=3
# KLINE_MIN_CLOSE_RISE_PCT=0.3

# --- 资金流向 ---
ENABLE_CAPITAL_FLOW=true
MAX_CAPITAL_ENRICH=300

# --- 北向资金情绪 ---
# 注意: 北向日度净买额自 2024-08 起全行业断供 (东财NaN/同花顺反爬/hexin静态数据)
# 设为 true 也会返回"数据不可用", 保留开关以备未来数据恢复
ENABLE_NORTHBOUND=false

# --- 回测 L3 波动率 ---
# BT_L3_MAX_VOLATILITY=0.60

# --- 输出 ---
REPORT_OUTPUT_DIR=./reports
